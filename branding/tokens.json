{
  "brand": {
    "name": "FIGURA",
    "subtitle": "Arquitectura Financiera",
    "founder": "Isaias Enrique Valentino Figueroa Barra",
    "tagline": "Precisión en cada cifra. Control en cada margen.",
    "theme": "Obsidian & Champagne Glass"
  },
  "colors": {
    "obsidian": {
      "void": "#06070A",
      "deep": "#0B0D13",
      "elevated": "#121620",
      "border": "#232A3B"
    },
    "champagne": {
      "gold": "#D8C39E",
      "bright": "#EDE0C8",
      "deep": "#9A8460"
    },
    "ink": {
      "platinum": "#EEF1F6",
      "slateMist": "#96A1B5",
      "ashMuted": "#646F84"
    },
    "semantic": {
      "emeraldLedger": "#4FA88B",
      "mineralCobalt": "#5E89E8",
      "amberRetention": "#D49B54",
      "crimsonDeficit": "#D46A6A"
    }
  },
  "typography": {
    "sans": "Plus Jakarta Sans",
    "serif": "Instrument Serif",
    "numericFeatures": ["tnum", "zero-off"]
